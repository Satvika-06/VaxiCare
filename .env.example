SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
APP_NAME=VaxiCare
DATABASE_URL=sqlite:///vaxicare.db  
SEED_DEMO_DATA=true
PUBLIC_BASE_URL=http://localhost:5000

# Automatic SMS remains disabled until Twilio is configured and tested.
SMS_ENABLED=false
VAXICARE_TEST_SMS_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_FORCE_DEMO=true

# Firebase Cloud Messaging remains disabled until the project-specific settings
# and a private service-account JSON file are configured.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-credentials/serviceAccountKey.json
FIREBASE_VAPID_PUBLIC_KEY=
FIREBASE_CREDENTIALS_PATH=firebase-credentials/serviceAccountKey.json
FIREBASE_VAPID_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional Android SIM SMS Gateway
ANDROID_SMS_GATEWAY_ENABLED=false

# The scheduler checks at this interval; administrators can override timings in the dashboard.
REMINDER_TIMEZONE=Asia/Kolkata
REMINDER_DAYS_BEFORE=3
REMINDER_OVERDUE_ENABLED=false
REMINDER_OVERDUE_AFTER_DAYS=7
EMAIL_REMINDER_OVERDUE_AFTER_DAYS=1
REMINDER_CHECK_INTERVAL_SECONDS=60
SMS_MAX_ATTEMPTS=3
SMS_RETRY_MINUTES=15

MAIL_DEFAULT_SENDER=info@vaxicare.local

# Configure Gmail with an App Password; never use the normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_TTL_SECONDS=1800

# Scheduled email reminders stay disabled until explicitly enabled.
EMAIL_REMINDERS_ENABLED=false
REMINDER_TEST_EMAIL=


